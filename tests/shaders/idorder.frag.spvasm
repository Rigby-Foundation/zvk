; Valid numeric IDs deliberately put a composite before its constituents.
OpCapability Shader
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %1 "main" %3
OpExecutionMode %1 OriginUpperLeft
OpDecorate %3 Location 0
%4 = OpTypeVoid
%5 = OpTypeFunction %4
%6 = OpTypeFloat 32
%7 = OpTypeVector %6 4
%8 = OpTypePointer Output %7
%3 = OpVariable %8 Output
%50 = OpConstant %6 0.25
%51 = OpConstant %6 0.5
%52 = OpConstant %6 0.75
%53 = OpConstant %6 1
%2 = OpConstantComposite %7 %50 %51 %52 %53
%1 = OpFunction %4 None %5
%9 = OpLabel
%10 = OpCompositeInsert %7 %51 %2 0
OpStore %3 %10
OpReturn
OpFunctionEnd
