#version 450
layout(local_size_x=1) in;
layout(set=0,binding=0,std430) buffer Results { uvec4 v[4]; } result;
layout(set=0,binding=1,std430) buffer Source { uint v[]; } source;
layout(set=0,binding=2,std140) uniform Params { uvec4 v[2]; } params;
layout(set=0,binding=3) uniform usamplerBuffer texels;
layout(set=0,binding=4,r32ui) uniform uimageBuffer storage_texels;
void main() {
    uint i=gl_GlobalInvocationID.x;
    result.v[i]=uvec4(source.v[i],params.v[i].x,texelFetch(texels,int(i)).x,imageLoad(storage_texels,int(i)).x);
    source.v[i]=70u+i;
    atomicAdd(source.v[i],1u);
    imageStore(storage_texels,int(i),uvec4(80u+i));
    imageAtomicAdd(storage_texels,int(i),1u);
    if(i==3u) {
        int negative=int(i)-4;
        result.v[3]=uvec4(source.v[negative],params.v[1].y,texelFetch(texels,negative).x,imageLoad(storage_texels,negative).x);
        source.v[negative]=123u;
        atomicAdd(source.v[negative],1u);
        imageStore(storage_texels,negative,uvec4(123u));
        imageAtomicAdd(storage_texels,negative,1u);
    }
}
