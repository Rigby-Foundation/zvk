#version 450
layout(local_size_x=4) in;
layout(set=0,binding=0,std430) buffer Data { vec4 values[]; } data;
layout(set=0,binding=1,std140) uniform Params { vec4 factor; } params;
layout(push_constant) uniform Push { vec4 bias; } push;
vec4 initial=vec4(1,2,3,4);
void main() {
    uint i=gl_GlobalInvocationID.x;
    if (i<data.values.length()) data.values[i]=vec4(float(i))*params.factor+push.bias+initial;
}
