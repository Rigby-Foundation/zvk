#version 450
layout(local_size_x=8) in;
layout(constant_id=7) const uint extra=0;
layout(set=0,binding=0,std430) buffer Data { uint values[]; } data;
layout(set=0,binding=1,std140) uniform Params { uint factor; } params;
layout(push_constant) uniform Push { uint bias; } push;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if (i < data.values.length()) data.values[i]=i*params.factor+push.bias+extra;
}
