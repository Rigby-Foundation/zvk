#version 450
layout(local_size_x=4) in;
layout(set=0,binding=0) uniform usamplerBuffer inputTexels;
layout(set=0,binding=1,rgba32f) uniform writeonly imageBuffer outputTexels;
void main() {
    int i=int(gl_GlobalInvocationID.x);
    if(i < textureSize(inputTexels))
        imageStore(outputTexels,i,vec4(texelFetch(inputTexels,i)));
}
