#version 450
layout(local_size_x=4, local_size_y=2) in;
layout(set=0,binding=0,rgba32f) uniform image2D outputImage;
layout(set=0,binding=1,rgba8) uniform readonly image2D inputImage;
layout(set=0,binding=2,r32ui) uniform uimage2D counters;
layout(set=0,binding=3,std430) buffer Results { uint values[]; } result;
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    ivec2 size=imageSize(outputImage);
    if (all(lessThan(p,size))) {
        vec4 pixel=imageLoad(inputImage,p);
        imageStore(outputImage,p,vec4(pixel.rg,float(p.x+size.x*p.y),1));
        uint old=imageAtomicAdd(counters,ivec2(0),1u);
        result.values[p.y*size.x+p.x]=old;
    }
}
