#version 450
layout(local_size_x=4,local_size_y=2) in;
layout(set=0,binding=0,rgba32f) uniform readonly image2D sourceImage;
layout(set=0,binding=1,rgba8) uniform writeonly image2D destinationImage;
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    vec4 v=imageLoad(sourceImage,p);
    imageStore(destinationImage,p,vec4(v.x+0.01,v.y,float(p.x)-2.0,0.5));
}
