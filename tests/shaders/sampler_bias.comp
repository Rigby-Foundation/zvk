#version 450
layout(local_size_x=1) in;
layout(set=0,binding=0) uniform sampler2D source;
layout(set=0,binding=1,std430) buffer Result { vec4 values[2]; } result;
void main() {
    result.values[0]=textureLod(source,vec2(0.5),2.0);
    result.values[1]=textureGrad(source,vec2(0.5),vec2(0.125,0),vec2(0,0.125));
}
